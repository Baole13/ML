# Animal Visual Search — backend environment
# Copy to `.env` and adjust. All values have sensible code defaults.

# Path to the serving artifact package produced by the notebook
# "Serving Export" cell (contains manifest.json, classifier, faiss, gallery/).
ARTIFACTS_DIR=./artifacts

# Encoder backend: "dinov2" (real DINOv2 ViT-S/14) or "mock" (offline tests).
ENCODER=dinov2

# Device: "auto", "cpu", or "cuda".
DEVICE=auto

# Max neighbours returned by /api/v1/search.
MAX_K=20

# Max accepted upload size in megabytes.
MAX_UPLOAD_MB=10

# Comma-separated allowed CORS origins, or "*" for permissive (local dev).
CORS_ORIGINS=*

# Public URL prefix for gallery images.
GALLERY_URL_PREFIX=/gallery

# Future OOD / confidence gate. Reserved — no behavior change yet.
ENABLE_UNKNOWN_GATE=false

# Require a calibrated classifier (predict_proba) in the artifact package.
# true  -> startup fails fast if the head is uncalibrated (production default).
# false -> allow uncalibrated heads (local/synthetic artifacts).
REQUIRE_CALIBRATED=true

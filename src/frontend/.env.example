# Base URL of the FastAPI backend.
#
# Dev (default): leave EMPTY. The Vite dev server proxies /api and /gallery
# to VITE_DEV_API_TARGET (http://127.0.0.1:8000), so a same-origin "" works.
#
# Production: set this to the deployed backend origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com
#
# Gallery image URLs returned by the API are relative ("/gallery/..."), so the
# same base is prepended to them for <img src>.
VITE_API_BASE_URL=

# (Dev only) where the Vite proxy forwards /api and /gallery.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
